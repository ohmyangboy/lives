{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lives",
  "version": "0.1.11",
  "identifier": "com.yangbukun.lives",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lives",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/Volumes/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/live-photo-service"
    ],
    "resources": {
      "resources/LiveCollagePhotosHelper.app": "LiveCollagePhotosHelper.app"
    },
    "category": "Photography",
    "shortDescription": "把 1～3 段视频制作成拼贴 Live Photo",
    "longDescription": "Lives 在 Mac 本机完成视频选段、拼贴和 Live Photo 生成，并保存到照片图库。",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 640,
          "height": 440
        },
        "windowPosition": {
          "x": 240,
          "y": 160
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 190
        }
      },
      "signingIdentity": "Developer ID Application: Yonghao Yang (LGKLTGNTY2)",
      "bundleVersion": "0.1.11"
    }
  }
}
